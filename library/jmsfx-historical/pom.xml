<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <!--
      jmsfx-historical has its own version line (jmsfx#175): it changes on its own schedule, and a tag named
      jmsfx-historical-X.Y.Z releases it alone. Central takes no artifact whose parent is a snapshot, so the
      parent is the released jmsfx-parent from Central rather than the one in this tree, and jmsfx-core is
      pinned to a released version below - which is how jmsfx-parent says a lifecycle is split off. Move
      both forward deliberately, when a jmsfx release has something this library needs.
  -->
  <parent>
    <groupId>io.github.ctgnz</groupId>
    <artifactId>jmsfx-parent</artifactId>
    <version>2.0.2</version>
    <relativePath/>
  </parent>

  <properties>
      <!-- Two levels below the repository root (see jmsfx-parent). -->
      <jmsfx.root>${project.basedir}/../..</jmsfx.root>
      <jmsfx.core.version>2.0.2</jmsfx.core.version>
  </properties>
  <artifactId>jmsfx-historical</artifactId>
  <!-- Its own, not the repository's. jmsfx-parent's jmsfx.historical.version must name the same. -->
  <version>2.1.1-SNAPSHOT</version>
    <name>JMSFX Historical Extension</name>
    <description>An extension to the APP-6E symbology model for depicting historical military organisation: icons APP-6E dropped, an enlarged Dismounted Individual symbol set, and additional amplifiers for formations and equipment modern NATO armies no longer field.</description>
    <dependencies>
        <dependency>
            <groupId>io.github.ctgnz</groupId>
            <artifactId>jmsfx-core</artifactId>
            <version>${jmsfx.core.version}</version>
        </dependency>
        <!-- Without an engine on the test classpath surefire finds no tests and says nothing, so the
             contract below compiled and never ran. The other two libraries declare these; this one
             did not. See jmsfx#127. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The injected-markup contract, which this library's own test subclasses. See jmsfx#122. -->
        <dependency>
            <groupId>io.github.ctgnz</groupId>
            <artifactId>jmsfx-core</artifactId>
            <version>${jmsfx.core.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src/main/java</sourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <subpackages>io.github.ctgnz.jmsfx.historical</subpackages>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>